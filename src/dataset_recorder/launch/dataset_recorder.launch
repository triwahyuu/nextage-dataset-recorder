<?xml version="1.0"?>
<launch>

  <arg name="task_config_path"/>
  <arg name="save_dir" default="/workspaces/dataset-recorder/recordings"/>
  <arg name="kinect_left_sn" default="000153513712"/>
  <arg name="kinect_right_sn" default="000231113712"/>
  <arg name="fps" default="15"/>                        <!-- FPS to run both cameras at. Valid options are 5, 15, and 30 -->
  <arg name="color_resolution" default="1080P"/>        <!-- Resolution at which to run the color camera. Valid options: 720P, 1080P, 1440P, 1536P, 2160P, 3072P -->

  <!--
  <include file="$(find dataset_recorder)/launch/dual_kinect_camera.launch">
    <arg name="kinect_left_sn" value="$(arg kinect_left_sn)"/>
    <arg name="kinect_right_sn" value="$(arg kinect_right_sn)"/>
    <arg name="fps" value="$(arg fps)"/>
    <arg name="color_resolution" value="$(arg color_resolution)"/>
  </include>
  -->

  <!-- Dataset Recorder Node -->
  <node name="dataset_recorder" pkg="dataset_recorder" type="dataset_recorder_node.py" output="screen">
    <param name="save_dir" value="$(arg save_dir)" />
    <param name="image_topic" value="/rgb/image_raw" />
    <param name="pointcloud_topic" value="/points2" />
    <param name="robot_state_topic" value="/joint_states" />
    <param name="task_config_path" value="$(arg task_config_path)" />
  </node>
</launch>
